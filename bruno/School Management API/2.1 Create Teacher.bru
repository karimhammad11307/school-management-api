meta {
  name: 2.1 Create Teacher
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/teachers
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Dr. Tariq Nabil",
    "email": "tariq.nabil@school.local"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("teacherId", res.body.id);
    bru.setEnvVar("teacherId", res.body.id);
  }
}
