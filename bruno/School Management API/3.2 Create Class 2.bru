meta {
  name: 3.2 Create Class 2
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/classes
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Science 202",
    "capacity": 5,
    "teacherId": "{{teacherId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("class2Id", res.body.id);
    bru.setEnvVar("class2Id", res.body.id);
  }
}
