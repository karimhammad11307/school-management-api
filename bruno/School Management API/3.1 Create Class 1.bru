meta {
  name: 3.1 Create Class 1
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/classes
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Math 101",
    "capacity": 1,
    "teacherId": "{{teacherId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("classId", res.body.id);
    bru.setEnvVar("classId", res.body.id);
  }
}
