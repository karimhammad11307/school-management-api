meta {
  name: 4.1 Create Student 1 in Class 1
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/students
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ahmed Hassan",
    "email": "ahmed.hassan@school.local",
    "classId": "{{classId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("studentId", res.body.id);
    bru.setEnvVar("studentId", res.body.id);
  }
}
